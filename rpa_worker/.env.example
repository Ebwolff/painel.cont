# Redis Queue Configuration
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=nfe_download_queue

# Webhook Configuration
WEBHOOK_URL=http://localhost:3000/api/webhooks/nfe/status
WEBHOOK_SECRET=your_secret_token_here

# Captcha Configuration (Choose one)
CAPTCHA_SERVICE=2captcha # or anticaptcha
CAPTCHA_API_KEY=your_captcha_api_key_here

# Playwright Configuration
HEADLESS=true
DOWNLOADS_DIR=./downloads

# Global Settings
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
