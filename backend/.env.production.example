# Exemplo de Variáveis para Deploy (Vercel)
# NÃO COLOQUE SENHAS REAIS AQUI. 
# Copie estas chaves para o painel de variáveis de ambiente da Vercel.

SUPABASE_URL=https://sua-url.supabase.co
SUPABASE_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

MASTER_ENCRYPTION_KEY=sua-chave-aes-gerada-no-passo-anterior

# URL do seu frontend (ex: https://meu-projeto.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173,https://sua-url.vercel.app

PORT=8000
DEBUG=False
