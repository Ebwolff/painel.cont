# Variáveis de Ambiente do NFe Worker

# Porta do Worker
PORT=3001

# Banco de Dados (PostgreSQL Compartilhado com o FastAPI)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=saas_contabil

# BullMQ Redis Fila de Jobs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Chave Mestra para Criptografar as Senhas dos Certificados (.pfx)
# DEVE TER EXATOS 32 CARACTERES PARA O AES-256
CERTIFICATE_ENCRYPTION_KEY="SUP3R_S3CR3T_K3Y_32_BYTES_MAX___"

# AWS / Storage (Para XMLs brutos)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_aws_key
AWS_SECRET_ACCESS_KEY=sua_aws_secret
AWS_S3_BUCKET=nfe-bucket-saas
